{
  "name": "assistant",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/copy-rive-wasm.mjs",
    "build": "tsc && vite build",
    "sync:rive-wasm": "node scripts/copy-rive-wasm.mjs",
    "preview": "vite preview",
    "tauri": "tauri",
    "lint": "npm run format && eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write src scripts vite.config.ts vitest.config.ts eslint.config.ts",
    "format:check": "prettier --check src scripts vite.config.ts vitest.config.ts eslint.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "contract:gen": "cd src-tauri && cargo test -p assistant-vault --lib export_bindings && cargo test -p assistant-app --test protocol_bindings",
    "contract:check": "npm run contract:gen && git diff --exit-code -- src/vault/core/contract src/types/protocol.contract.ts",
    "models-dev:update": "node scripts/update-models-dev-snapshot.mjs",
    "models-dev:check": "node scripts/update-models-dev-snapshot.mjs --check"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.4",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@rive-app/react-webgl2": "^4.36.0",
    "@tauri-apps/api": "^2.12.1",
    "@tauri-apps/plugin-autostart": "^2.7.0",
    "@tauri-apps/plugin-dialog": "^2.8.2",
    "@tauri-apps/plugin-global-shortcut": "^2.4.0",
    "@tauri-apps/plugin-log": "^2.10.1",
    "@tauri-apps/plugin-opener": "^2",
    "antd": "^6.6.5",
    "colord": "^2.10.0",
    "cron-validator": "^1.4.0",
    "cronstrue": "^3.30.0",
    "crypto-js": "^4.2.0",
    "date-fns": "^4.4.0",
    "diff": "^9.0.0",
    "fuse.js": "^7.5.0",
    "i18next": "^26.4.4",
    "i18next-browser-languagedetector": "^8.2.1",
    "json5": "^2.2.3",
    "jwt-decode": "^4.0.0",
    "katex": "^0.19.0",
    "mathjs": "^15.2.0",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-i18next": "^17.0.16",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.4",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "sql-formatter": "^15.9.0",
    "uuid": "^14.0.2",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@tauri-apps/cli": "^2.12.1",
    "@types/crypto-js": "^4.2.2",
    "@types/diff": "^7.0.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.71.0",
    "@typescript-eslint/parser": "^8.71.0",
    "@vitejs/plugin-react": "^6.0.2",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "graphology": "^0.26.0",
    "graphology-communities-louvain": "^2.0.2",
    "jiti": "^2.7.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.0.16",
    "vitest": "^5.0.3"
  }
}
